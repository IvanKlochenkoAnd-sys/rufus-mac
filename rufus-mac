# ANSI Terminal Colors
class Colors:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    RED = '\033[91m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'
    DIM = '\033[2m'
    RESET = '\033[0m'

def log_info(msg: str):
    print(f"{Colors.BLUE}[*]{Colors.RESET} {msg}")

def log_success(msg: str):
    print(f"{Colors.GREEN}[✓]{Colors.RESET} {Colors.BOLD}{msg}{Colors.RESET}")

def log_warn(msg: str):
    print(f"{Colors.YELLOW}[!]{Colors.RESET} {Colors.BOLD}{msg}{Colors.RESET}")

def log_error(msg: str):
    print(f"{Colors.RED}[✗]{Colors.RESET} {Colors.BOLD}{msg}{Colors.RESET}")

def format_size(bytes_val: int) -> str:
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if bytes_val < 1024.0:
            return f"{bytes_val:.1f} {unit}"
        bytes_val /= 1024.0
    return f"{bytes_val:.1f} PB"


class DiskManager:
    """Manages disk enumeration, filtering, and safety checks on macOS."""

    @staticmethod
    def get_disks() -> List[Dict]:
        """Returns a list of external, removable USB physical disks safe for formatting."""
        try:
            cmd = ['diskutil', 'list', '-plist']
            output = subprocess.check_output(cmd, stderr=subprocess.PIPE)
            data = plistlib.loads(output)
        except Exception as e:
            log_error(f"Failed to query diskutil list: {e}")
            return []

        all_disks = data.get('AllDisksAndPartitions', [])
        usb_disks = []

        for item in all_disks:
            dev_id = item.get('DeviceIdentifier', '')
            if not dev_id:
                continue

            # Query detailed info for the physical whole disk
            info = DiskManager.get_disk_info(dev_id)
            if not info:
                continue

            # Strict safety filter:
            # 1. Must NOT be an internal drive
            if info.get('Internal', True):
                continue

            # 2. Must NOT be a virtual disk image or APFS synthesized container
            bus_protocol = info.get('BusProtocol', '')
            if bus_protocol in ['Disk Image', 'Virtual', 'Apple Fabric']:
                continue

            # 3. Must be external, removable media, or USB/Thunderbolt bus protocol
            is_external = (info.get('Internal') is False) or (info.get('DeviceLocation') == 'External')
            is_removable = info.get('Removable', False) or info.get('RemovableMedia', False)
            is_usb_tb = (bus_protocol in ['USB', 'Thunderbolt', 'FireWire'])

            if not (is_external or is_usb_tb or is_removable):
                continue

            # 4. Must be a whole physical disk
            if not info.get('WholeDisk', True):
                continue

            size_bytes = info.get('TotalSize', info.get('Size', 0))
            # Require at least 4 GB
            if size_bytes < 4 * 1024 * 1024 * 1024:
                continue

            media_name = info.get('MediaName', info.get('IORegistryEntryName', 'USB Flash Drive'))

            # Gather mounted partitions if any
            mounted_partitions = []
            for part in item.get('Partitions', []):
                part_id = part.get('DeviceIdentifier', '')
                part_info = DiskManager.get_disk_info(part_id)
                if part_info and part_info.get('Mounted', False):
                    mounted_partitions.append({
                        'id': part_id,
                        'name': part_info.get('VolumeName', 'Untitled'),
                        'mount_point': part_info.get('MountPoint', '')
                    })

            usb_disks.append({
                'identifier': dev_id,
                'device_node': f"/dev/{dev_id}",
                'raw_node': f"/dev/r{dev_id}",
                'media_name': media_name,
                'size_bytes': size_bytes,
                'size_str': format_size(size_bytes),
                'bus': bus_protocol,
                'mounted_partitions': mounted_partitions
            })

        return usb_disks

    @staticmethod
    def get_disk_info(dev_id: str) -> Optional[Dict]:
        """Gets plist info for a specific disk identifier."""
        try:
            cmd = ['diskutil', 'info', '-plist', dev_id]
            output = subprocess.check_output(cmd, stderr=subprocess.PIPE)
            return plistlib.loads(output)
        except Exception:
            return None

    @staticmethod
    def unmount_disk(dev_node: str) -> bool:
        """Unmounts all partitions of the specified disk with forced fallback and retry."""
        log_info(f"Unmounting {dev_node}...")
        
        # Attempt 1: Standard graceful unmount
        res = subprocess.run(['diskutil', 'unmountDisk', dev_node], capture_output=True, text=True)
        if res.returncode == 0:
            return True
            
        # Attempt 2: Forced unmount
        log_warn("Standard unmount busy. Attempting forced unmount...")
        res_force = subprocess.run(['diskutil', 'unmountDisk', 'force', dev_node], capture_output=True, text=True)
        if res_force.returncode == 0:
            return True
            
        # Attempt 3: Explicitly unmount child partition nodes (e.g. disk17s1, disk17s2)
        dev_id = dev_node.replace("/dev/", "")
        for i in range(1, 5):
            part_node = f"/dev/{dev_id}s{i}"
            subprocess.run(['diskutil', 'unmount', 'force', part_node], capture_output=True)
            
        time.sleep(1)
        res_final = subprocess.run(['diskutil', 'unmountDisk', 'force', dev_node], capture_output=True, text=True)
        return res_final.returncode == 0


class ISOInspector:
    """Mounts and inspects Windows ISO images for Windows 11 compatibility."""

    def __init__(self, iso_path: str):
        self.iso_path = Path(iso_path).resolve()
        self.mount_point: Optional[Path] = None
        self.attached_dev: Optional[str] = None
        self.is_windows = False
        self.has_uefi = False
        self.has_boot_wim = False
        self.install_wim_path: Optional[Path] = None
        self.install_wim_size = 0
        self.is_wim_large = False  # > 4GB

    def _find_existing_mount(self) -> Tuple[Optional[Path], Optional[str]]:
        """Checks if the ISO is already mounted on the system."""
        # Check 1: If path is already a directory with Windows install media
        if self.iso_path.is_dir():
            if self.find_file(self.iso_path, ['sources', 'boot.wim']):
                return self.iso_path, None

        # Check 2: Check active volumes under /Volumes/
        try:
            for vol in Path('/Volumes').iterdir():
                if vol.is_dir() and not vol.name.startswith('.'):
                    if self.find_file(vol, ['sources', 'boot.wim']) and (self.find_file(vol, ['sources', 'install.wim']) or self.find_file(vol, ['sources', 'install.esd'])):
                        if vol.name.lower() in self.iso_path.name.lower() or "cccoma" in vol.name.lower() or "win" in vol.name.lower():
                            return vol, None
        except Exception:
            pass

        # Check 3: Check hdiutil info for attached disk images matching this ISO path
        try:
            out = subprocess.check_output(['hdiutil', 'info', '-plist'], stderr=subprocess.PIPE)
            data = plistlib.loads(out)
            for img in data.get('images', []):
                img_path = img.get('image-path', '')
                if os.path.realpath(img_path) == os.path.realpath(str(self.iso_path)):
                    dev = None
                    mp = None
                    for ent in img.get('system-entities', []):
                        if 'mount-point' in ent:
                            mp = Path(ent['mount-point'])
                        if 'dev-entry' in ent and not dev:
                            dev = ent['dev-entry']
                    if mp and mp.exists():
                        return mp, dev
        except Exception:
            pass
        return None, None

    def mount(self) -> bool:
        if not self.iso_path.exists():
            log_error(f"ISO file or directory does not exist: {self.iso_path}")
            return False

        # If user directly specified an already mounted volume (e.g. /Volumes/CCCOMA_...)
        if self.iso_path.is_dir():
            if self.find_file(self.iso_path, ['sources', 'boot.wim']):
                self.mount_point = self.iso_path
                self.attached_dev = None
                log_success(f"Using provided mounted directory: {self.mount_point}")
                return self._inspect()

        log_info(f"Mounting ISO: {self.iso_path.name}...")

        # Step 1: Remove quarantine attribute if present
        try:
            subprocess.run(['xattr', '-d', 'com.apple.quarantine', str(self.iso_path)], capture_output=True)
        except Exception:
            pass

        # Step 2: Check if ISO is already attached or mounted
        existing_mp, existing_dev = self._find_existing_mount()
        if existing_mp and existing_mp.exists():
            self.mount_point = existing_mp
            self.attached_dev = existing_dev
            log_success(f"Using active ISO mount: {self.mount_point}")
            return self._inspect()

        # Step 3: Raw UDF Mount Strategy (Essential for Windows 11 ISOs on macOS)
        # Windows 11 installation ISOs use ISO-9660 + UDF 2.01 format. macOS DiskImages2
        # will fail with 'The disk image is corrupted' or 'image not recognized' unless
        # attached with diskimage-class=CRawDiskImage.
        try:
            attach_cmd = [
                'hdiutil', 'attach',
                '-imagekey', 'diskimage-class=CRawDiskImage',
                '-nomount',
                str(self.iso_path)
            ]
            res = subprocess.run(attach_cmd, capture_output=True, text=True)
            if res.returncode == 0:
                dev_match = re.search(r"(/dev/disk\d+)", res.stdout)
                if dev_match:
                    dev_node = dev_match.group(1)
                    self.attached_dev = dev_node
                    time.sleep(0.5)
                    # Mount the attached disk read-only
                    mount_res = subprocess.run(['diskutil', 'mount', 'readOnly', dev_node], capture_output=True, text=True)
                    # Retrieve the mount point via diskutil info
                    info_res = subprocess.run(['diskutil', 'info', '-plist', dev_node], capture_output=True)
                    if info_res.returncode == 0:
                        info = plistlib.loads(info_res.stdout)
                        mp = info.get('MountPoint')
                        if mp and Path(mp).exists():
                            self.mount_point = Path(mp)
                            log_success(f"ISO mounted at: {self.mount_point} ({dev_node})")
                            return self._inspect()
                    # Fallback parse mount output
                    if not self.mount_point:
                        for line in mount_res.stdout.splitlines():
                            if "mounted" in line and "Volume " in line:
                                vol_name = line.split("Volume ")[1].split(" on ")[0].strip()
                                candidate = Path(f"/Volumes/{vol_name}")
                                if candidate.exists():
                                    self.mount_point = candidate
                                    log_success(f"ISO mounted at: {self.mount_point} ({dev_node})")
                                    return self._inspect()
        except Exception:
            pass

        # Step 4: Multi-strategy fallback mounting attempts
        mount_attempts = []
        sudo_user = os.environ.get('SUDO_USER')

        # Strategy A: If running as root (via sudo), attach as the real user to avoid TCC denial on ~/Downloads
        if os.geteuid() == 0 and sudo_user:
            mount_attempts.append([
                'sudo', '-u', sudo_user,
                'hdiutil', 'attach', '-noverify', '-noautofsck', '-noautoopen', '-nobrowse', '-readonly', str(self.iso_path)
            ])

        # Strategy B: Standard hdiutil with -noverify and -noautofsck
        mount_attempts.append([
            'hdiutil', 'attach', '-noverify', '-noautofsck', '-noautoopen', '-nobrowse', '-readonly', str(self.iso_path)
        ])

        # Strategy C: macOS 27 diskutil image attach
        mount_attempts.append([
            'diskutil', 'image', 'attach', '--mountOptions', 'nobrowse', '--readOnly', str(self.iso_path)
        ])

        last_err = ""
        for cmd in mount_attempts:
            res = subprocess.run(cmd, capture_output=True, text=True)
            if res.returncode == 0:
                out = res.stdout
                lines = out.strip().split('\n')
                for line in lines:
                    parts = line.split()
                    if len(parts) >= 3 and '/Volumes/' in line:
                        idx = line.find('/Volumes/')
                        self.mount_point = Path(line[idx:].strip())
                        self.attached_dev = parts[0]
                        break
                if self.mount_point and self.mount_point.exists():
                    break
            else:
                last_err = (res.stderr or res.stdout or "").strip()

        if not self.mount_point or not self.mount_point.exists():
            log_error(f"Failed to mount ISO: {last_err or 'Could not attach disk image'}")
            if "operation not permitted" in last_err.lower():
                log_warn("macOS Privacy (TCC) prevented mounting the file in its current location.")
                print(f"\n{Colors.BOLD}Quick Resolution Steps:{Colors.RESET}")
                print(f"1. {Colors.CYAN}Run directly without sudo{Colors.RESET} (the tool will prompt for password only when formatting):")
                print(f"   rufus-mac\n")
                print(f"2. {Colors.CYAN}Or move the ISO to /Users/Shared/{Colors.RESET} (bypasses ~/Downloads TCC locks):")
                print(f"   mv \"{self.iso_path}\" /Users/Shared/\n")
                print(f"3. {Colors.CYAN}Or grant Full Disk Access to Terminal{Colors.RESET}:")
                print(f"   System Settings → Privacy & Security → Full Disk Access → Enable Terminal\n")
            return False

        log_success(f"ISO mounted at: {self.mount_point}")
        return self._inspect()

    def _inspect(self) -> bool:
        assert self.mount_point is not None

        # Look for UEFI bootloader
        efi_boot_x64 = self.find_file(self.mount_point, ['efi', 'boot', 'bootx64.efi'])
        efi_boot_arm64 = self.find_file(self.mount_point, ['efi', 'boot', 'bootaa64.efi'])
        self.has_uefi = bool(efi_boot_x64 or efi_boot_arm64)

        # Look for WinPE boot image
        boot_wim = self.find_file(self.mount_point, ['sources', 'boot.wim'])
        self.has_boot_wim = bool(boot_wim)

        # Look for OS payload (install.wim or install.esd)
        install_wim = self.find_file(self.mount_point, ['sources', 'install.wim'])
        install_esd = self.find_file(self.mount_point, ['sources', 'install.esd'])
        self.install_wim_path = install_wim or install_esd

        if self.install_wim_path and self.install_wim_path.exists():
            self.install_wim_size = self.install_wim_path.stat().st_size
            # 4 GiB = 4,294,967,296 bytes. FAT32 max file size is 4,294,967,295.
            self.is_wim_large = (self.install_wim_size >= 4 * 1024 * 1024 * 1024)

        self.is_windows = bool(self.has_boot_wim and self.install_wim_path)

        if not self.is_windows:
            log_warn("The selected image does not appear to be a standard Windows installation media.")
            return False

        wim_name = self.install_wim_path.name if self.install_wim_path else "None"
        log_success(f"Valid Windows image verified.")
        log_info(f"UEFI Bootloader: {'Present (x64/ARM64)' if self.has_uefi else 'Missing'}")
        log_info(f"OS Payload: {wim_name} ({format_size(self.install_wim_size)})")
        if self.is_wim_large:
            log_warn(f"{wim_name} exceeds the 4GB FAT32 limit! Automatic dual-partition UEFI mode will be utilized.")

        return True

    @staticmethod
    def find_file(root: Path, relative_parts: List[str]) -> Optional[Path]:
        """Case-insensitive path locator."""
        current = root
        for part in relative_parts:
            found = None
            if not current.is_dir():
                return None
            for child in current.iterdir():
                if child.name.lower() == part.lower():
                    found = child
                    break
            if not found:
                return None
            current = found
        return current

    def unmount(self):
        if self.attached_dev:
            log_info(f"Detaching ISO image ({self.attached_dev})...")
            subprocess.run(['diskutil', 'unmount', 'force', self.attached_dev], capture_output=True)
            subprocess.run(['diskutil', 'eject', self.attached_dev], capture_output=True)
            subprocess.run(['hdiutil', 'detach', self.attached_dev], capture_output=True)
            self.attached_dev = None
            self.mount_point = None


class WindowsCustomizer:
    """Generates autounattend.xml and Windows 11 compatibility bypasses."""

    @staticmethod
    def generate_autounattend(
        bypass_tpm_secureboot: bool = True,
        bypass_ram_cpu_storage: bool = True,
        bypass_online_account: bool = True,
        disable_bitlocker: bool = True,
        local_username: Optional[str] = None
    ) -> str:
        """Constructs an autounattend.xml answer file tailored to user options."""

        sync_commands_pe = []
        order = 1

        if bypass_tpm_secureboot:
            sync_commands_pe.append(f"""                <RunSynchronousCommand wcm:action="add">
                    <Order>{order}</Order>
