def install_cli():
    """Installs rufus-mac to system PATH (/usr/local/bin or ~/.local/bin) for global access."""
    script_path = Path(os.path.realpath(__file__))
    target_dir = Path("/usr/local/bin")
    symlink_path = target_dir / "rufus-mac"

    print("\n" + "="*60)
    print(f"{Colors.BOLD}{Colors.CYAN}Rufus for macOS - Command Installation{Colors.RESET}")
    print("="*60)
    log_info(f"Source executable: {script_path}")

    installed = False

    # 1. Attempt system-wide install if /usr/local/bin is writable
    if target_dir.exists() and os.access(str(target_dir), os.W_OK):
        try:
            if symlink_path.exists() or symlink_path.is_symlink():
                symlink_path.unlink()
            symlink_path.symlink_to(script_path)
            installed = True
            log_success(f"Installed system-wide symlink: {symlink_path}")
        except Exception:
            pass

    # 2. User-level PATH directories (e.g. ~/.gemini/antigravity/bin, ~/.local/bin)
    user_candidates = [
        Path("/Users/ivanklochenko/.gemini/antigravity/bin"),
        Path.home() / ".local" / "bin",
        Path.home() / "bin"
    ]
    for u_dir in user_candidates:
        if u_dir.exists() and os.access(str(u_dir), os.W_OK):
            try:
                u_link = u_dir / "rufus-mac"
                if u_link.exists() or u_link.is_symlink():
                    u_link.unlink()
                u_link.symlink_to(script_path)
                log_success(f"Installed to user PATH: {u_link}")
                installed = True
            except Exception:
                pass

    if installed:
        print("\n" + "="*60)
        log_success("READY TO USE GLOBALLY!")
        print("="*60)
        print(f"You can now run {Colors.BOLD}{Colors.CYAN}rufus-mac{Colors.RESET} directly from any directory in your terminal!\n")
    else:
        print(f"\nTo install system-wide across all users, run:")
        print(f"  {Colors.CYAN}sudo ln -sf \"{script_path}\" /usr/local/bin/rufus-mac{Colors.RESET}\n")


def main():
    parser = argparse.ArgumentParser(
        description="Rufus for macOS (rufus-mac) - Reliable Windows 11 Bootable USB Creator for Mac",
        epilog="Supported macOS: 10.15 Catalina through macOS 27 Golden Gate (Apple Silicon & Intel)"
    )
    parser.add_argument("--iso", help="Path to Windows 10/11 ISO file")
    parser.add_argument("--target", help="Target disk identifier (e.g. disk17)")
    parser.add_argument("--list-disks", action="store_true", help="List safe USB drives and exit")
    parser.add_argument("--bypass-all", action="store_true", default=True, help="Enable all Windows 11 hardware and account bypasses")
    parser.add_argument("--no-bypass", action="store_true", help="Disable all Windows 11 bypasses")
    parser.add_argument("--single-fat32", action="store_true", help="Use single FAT32 partition with split WIM (requires wimlib)")
    parser.add_argument("--install", action="store_true", help="Install rufus-mac to system PATH (/usr/local/bin) for global access")
    parser.add_argument("-v", "--version", action="version", version=f"RufusMac {VERSION}")

    args = parser.parse_args()

    if args.install:
        install_cli()
        return

    if args.list_disks:
        print("\n" + "="*50)
        print("Connected Removable USB Drives:")
        print("="*50)
        disks = DiskManager.get_disks()
        if not disks:
            print("  No removable USB drives found.")
        for d in disks:
            print(f"  • {d['identifier']}: {d['media_name']} ({d['size_str']}) - {d['device_node']}")
        print("="*50 + "\n")
        return

    # If no arguments given, launch the interactive wizard
    if not args.iso and not args.target:
        interactive_wizard()
        return

    if not args.iso or not args.target:
        log_error("Both --iso and --target must be specified in headless mode.")
        parser.print_help()
        sys.exit(1)

    target_id = args.target.replace("/dev/", "").replace("r", "")
    iso_path = os.path.expanduser(args.iso)

    # Safety check on target disk
    disks = DiskManager.get_disks()
    matched = next((d for d in disks if d['identifier'] == target_id), None)
    if not matched:
        log_error(f"Target disk '{target_id}' is not an external removable USB drive! Aborting for safety.")
        sys.exit(1)

    inspector = ISOInspector(iso_path)
    if not inspector.mount():
        sys.exit(1)

    enable_bypasses = not args.no_bypass
    writer = RufusWriter(
        disk_identifier=target_id,
        iso_inspector=inspector,
        use_dual_partition=not args.single_fat32,
        bypass_tpm_secureboot=enable_bypasses,
        bypass_ram_cpu_storage=enable_bypasses,
        bypass_online_account=enable_bypasses,
        disable_bitlocker=enable_bypasses
    )

    try:
        success = writer.write()
    finally:
        inspector.unmount()

    sys.exit(0 if success else 1)


if __name__ == '__main__':
    main()
