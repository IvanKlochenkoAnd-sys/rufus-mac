        return xml_content

    @staticmethod
    def apply_bypasses(target_volume: Path, autounattend_xml: str):
        """Writes autounattend.xml and applies the appraiser bypass."""
        log_info(f"Injecting Windows 11 bypasses into {target_volume.name}...")

        # 1. Root autounattend.xml
        root_xml = target_volume / "autounattend.xml"
        try:
            with open(root_xml, 'w', encoding='utf-8') as f:
                f.write(autounattend_xml)
            log_success(f"Created {root_xml.name}")
        except Exception as e:
            log_error(f"Failed to write {root_xml}: {e}")

        # 2. $OEM$ backup unattend.xml for setup continuation
        panther_dir = target_volume / "sources" / "$OEM$" / "$$" / "Panther"
        try:
            panther_dir.mkdir(parents=True, exist_ok=True)
            with open(panther_dir / "unattend.xml", 'w', encoding='utf-8') as f:
                f.write(autounattend_xml)
            log_success("Created sources/$OEM$/$$/Panther/unattend.xml backup")
        except Exception as e:
            log_warn(f"Note: Could not create Panther backup directory: {e}")

        # 3. Patch sources/appraiserres.dll if it exists (legacy compatibility gate bypass)
        sources_dir = target_volume / "sources"
        if sources_dir.exists():
            for item in sources_dir.iterdir():
                if item.name.lower() == "appraiserres.dll":
                    try:
                        # Zero out the file
                        with open(item, 'wb') as f:
                            f.write(b"")
                        log_success("Patched sources/appraiserres.dll (Zeroed compatibility appraiser)")
                    except Exception as e:
                        log_warn(f"Could not patch appraiserres.dll: {e}")
                    break


class RufusWriter:
    """Orchestrates formatting, file replication, WIM splitting, and UEFI boot configuration."""

    def __init__(
        self,
        disk_identifier: str,
        iso_inspector: ISOInspector,
        use_dual_partition: bool = True,
        bypass_tpm_secureboot: bool = True,
        bypass_ram_cpu_storage: bool = True,
        bypass_online_account: bool = True,
        disable_bitlocker: bool = True,
        local_user: Optional[str] = None
    ):
        self.dev_id = disk_identifier
        self.dev_node = f"/dev/{disk_identifier}"
        self.iso = iso_inspector
        self.use_dual_partition = use_dual_partition
        self.bypass_tpm = bypass_tpm_secureboot
        self.bypass_hardware = bypass_ram_cpu_storage
        self.bypass_account = bypass_online_account
        self.disable_bitlocker = disable_bitlocker
        self.local_user = local_user

    def write(self) -> bool:
        start_time = time.time()
        print("\n" + "="*60)
        print(f"{Colors.BOLD}{Colors.CYAN}Rufus for macOS - Windows 11 Creation Engine{Colors.RESET}")
        print("="*60)
        log_info(f"Target Disk: {self.dev_node}")
        log_info(f"Source ISO:  {self.iso.iso_path.name}")
        log_info(f"Architecture: {'Universal Dual-Partition (FAT32 Boot + ExFAT Data)' if self.use_dual_partition else 'Single FAT32 (Split WIM)'}")
        print("="*60 + "\n")

        # Step 1: Unmount target disk
        DiskManager.unmount_disk(self.dev_node)

        # Step 2: Partition and Format
        if self.use_dual_partition:
            success = self._format_dual_partition()
        else:
            success = self._format_single_partition()

        if not success:
            log_error("Partitioning failed. Aborting.")
            return False

        # Step 3: Wait for volumes to mount
        time.sleep(2)
        boot_vol, install_vol = self._get_mounted_volumes()
        if not boot_vol:
            log_error("Could not find mounted boot volume after formatting.")
            return False

        log_success(f"Boot Partition Mounted:    {boot_vol}")
        if self.use_dual_partition and install_vol:
            log_success(f"Install Partition Mounted: {install_vol}")

        # Step 4: Transfer Files
        if self.use_dual_partition and install_vol:
            success = self._copy_dual_partition_files(boot_vol, install_vol)
        else:
            success = self._copy_single_partition_files(boot_vol)

        if not success:
            log_error("File transfer failed. Aborting.")
            return False

        # Step 5: Inject Windows 11 Bypasses
        unattend_xml = WindowsCustomizer.generate_autounattend(
            bypass_tpm_secureboot=self.bypass_tpm,
            bypass_ram_cpu_storage=self.bypass_hardware,
            bypass_online_account=self.bypass_account,
            disable_bitlocker=self.disable_bitlocker,
            local_username=self.local_user
        )

        WindowsCustomizer.apply_bypasses(boot_vol, unattend_xml)
        if self.use_dual_partition and install_vol:
            WindowsCustomizer.apply_bypasses(install_vol, unattend_xml)

        # Step 6: Sync filesystem caches
        log_info("Flushing disk caches (sync)...")
        subprocess.run(['sync'])

        elapsed = time.time() - start_time
        mins, secs = divmod(int(elapsed), 60)
        print("\n" + "="*60)
        log_success(f"BOOTABLE WINDOWS 11 USB SUCCESSFULLY CREATED! ({mins}m {secs}s)")
        print("="*60)
        print(f"\n{Colors.BOLD}Next Steps for your PC:{Colors.RESET}")
        print("1. Safely eject the USB drive using Finder or 'diskutil eject'.")
        print("2. Insert the USB into the target PC.")
        print("3. Power on the PC and press your BIOS boot key (F12, F11, F8, or Del).")
        print("4. Select UEFI: Kingston / USB Device from the boot menu.")
        print(f"5. Windows 11 setup will boot cleanly with all hardware checks bypassed!\n")

        return True

    def _format_dual_partition(self) -> bool:
        """Partitions disk with GPT: Partition 1: FAT32 (1.5GB, WINBOOT), Partition 2: ExFAT (Rest, WININSTALL)."""
        log_info("Formatting USB with GPT Dual-Partition scheme...")
        base_cmd = [
            'diskutil', 'partitionDisk', self.dev_node, 'GPT',
            'FAT32', 'WINBOOT', '1.5G',
            'ExFAT', 'WININSTALL', '0'
        ]
        cmd = (['sudo'] + base_cmd) if os.geteuid() != 0 else base_cmd
        log_info(f"Executing: {' '.join(cmd)}")
        # If running as non-root, do not capture stdin/stdout so sudo can prompt for password if needed
        if os.geteuid() != 0:
            res = subprocess.run(cmd)
        else:
            res = subprocess.run(cmd, capture_output=True, text=True)

        if res.returncode != 0:
            err_msg = getattr(res, 'stderr', None) or getattr(res, 'stdout', None) or ""
            log_error(f"Partition command failed: {err_msg.strip()}")
            if "could not be unmounted" in str(err_msg).lower():
                log_warn("The USB volume is busy or locked by another app (Finder, disk mounters, etc.).")
            return False
        log_success("Partitioning completed successfully.")
        return True

    def _format_single_partition(self) -> bool:
        """Formats entire disk as a single GPT FAT32 partition."""
        log_info("Formatting USB with GPT Single FAT32 scheme...")
        base_cmd = ['diskutil', 'eraseDisk', 'FAT32', 'WIN11', 'GPT', self.dev_node]
        cmd = (['sudo'] + base_cmd) if os.geteuid() != 0 else base_cmd
        log_info(f"Executing: {' '.join(cmd)}")
        if os.geteuid() != 0:
            res = subprocess.run(cmd)
        else:
            res = subprocess.run(cmd, capture_output=True, text=True)

        if res.returncode != 0:
            err_msg = getattr(res, 'stderr', None) or getattr(res, 'stdout', None) or ""
            log_error(f"Erase command failed: {err_msg.strip()}")
            return False
        log_success("Formatting completed successfully.")
        return True

    def _get_mounted_volumes(self) -> Tuple[Optional[Path], Optional[Path]]:
        """Finds mounted volume paths for the target disk partitions."""
        time.sleep(1)
        info = DiskManager.get_disk_info(self.dev_id)
        boot_vol = None
        install_vol = None

        # Look in /Volumes/ for WINBOOT and WININSTALL or WIN11
        for candidate in Path("/Volumes").iterdir():
            if not candidate.is_dir():
                continue
            name = candidate.name.upper()
            if name == "WINBOOT":
                boot_vol = candidate
            elif name == "WININSTALL":
                install_vol = candidate
            elif name == "WIN11":
                boot_vol = candidate

        # Fallback check via diskutil info
        if not boot_vol:
            for part_id in [f"{self.dev_id}s1", f"{self.dev_id}s2"]:
                p_info = DiskManager.get_disk_info(part_id)
                if p_info and p_info.get('Mounted', False):
                    mp = Path(p_info.get('MountPoint', ''))
                    if mp.exists():
                        if not boot_vol:
                            boot_vol = mp
                        elif not install_vol:
                            install_vol = mp

        return boot_vol, install_vol

    def _copy_dual_partition_files(self, boot_vol: Path, install_vol: Path) -> bool:
        """Copies UEFI boot files to WINBOOT and full OS image to WININSTALL."""
        src_root = self.iso.mount_point
        assert src_root is not None

        # 1. Files for WINBOOT (Boot Partition)
        # Needs: boot/, efi/, bootmgr, bootmgr.efi, sources/boot.wim
        log_info("Stage 1/2: Copying UEFI Bootloader & WinPE files to WINBOOT...")

        boot_items = ['boot', 'efi', 'bootmgr', 'bootmgr.efi']
        for item_name in boot_items:
            src_item = ISOInspector.find_file(src_root, [item_name])
            if src_item and src_item.exists():
                dst_item = boot_vol / src_item.name
                log_info(f"Copying {src_item.name} to WINBOOT...")
                self._copy_recursive(src_item, dst_item)

        # Copy sources/boot.wim to WINBOOT
        src_boot_wim = ISOInspector.find_file(src_root, ['sources', 'boot.wim'])
        if src_boot_wim and src_boot_wim.exists():
            dst_sources = boot_vol / "sources"
            dst_sources.mkdir(exist_ok=True)
            dst_boot_wim = dst_sources / "boot.wim"
            log_info(f"Copying {src_boot_wim.name} ({format_size(src_boot_wim.stat().st_size)}) to WINBOOT...")
            self._copy_file_with_progress(src_boot_wim, dst_boot_wim)
        else:
            log_error("Could not find sources/boot.wim in ISO!")
            return False

        log_success("WINBOOT boot files copied.")

        # 2. Files for WININSTALL (Data & Installation Partition)
        # Needs: All ISO contents (including the full install.wim)
        log_info("Stage 2/2: Copying complete Windows 11 installation payload to WININSTALL...")
        total_iso_files = list(src_root.iterdir())
        for idx, item in enumerate(total_iso_files, 1):
            dst_item = install_vol / item.name
            log_info(f"[{idx}/{len(total_iso_files)}] Transferring {item.name}...")
            self._copy_recursive(item, dst_item)

        log_success("WININSTALL files copied.")
        return True

    def _copy_single_partition_files(self, boot_vol: Path) -> bool:
        """Copies all ISO files to single FAT32 partition, splitting install.wim into SWM."""
        src_root = self.iso.mount_point
        assert src_root is not None

        log_info("Copying installation files to WIN11...")
        for item in src_root.iterdir():
            if item.name.lower() == "sources":
                # Handle sources directory separately to split install.wim
                dst_sources = boot_vol / "sources"
                dst_sources.mkdir(exist_ok=True)
                for src_file in item.iterdir():
                    if src_file.name.lower() in ['install.wim', 'install.esd']:
                        # Split WIM
                        self._split_and_copy_wim(src_file, dst_sources)
                    else:
                        dst_file = dst_sources / src_file.name
                        self._copy_recursive(src_file, dst_file)
            else:
                dst_item = boot_vol / item.name
                self._copy_recursive(item, dst_item)

        return True

    def _split_and_copy_wim(self, src_wim: Path, dst_dir: Path):
        """Splits install.wim into 3800MB chunks using wimlib-imagex if available."""
        wimlib_bin = shutil.which("wimlib-imagex") or shutil.which("wimsplit")
        dst_swm = dst_dir / "install.swm"

        if wimlib_bin:
            log_info(f"Splitting {src_wim.name} with {Path(wimlib_bin).name} into 3800MB chunks...")
            cmd = [wimlib_bin, "split", str(src_wim), str(dst_swm), "3800"]
            subprocess.run(cmd, check=True)
            log_success("WIM successfully split into SWM files.")
        else:
            log_warn("wimlib-imagex not found. Falling back to direct chunk transfer...")
            # If not installed, fallback to direct copy or warn
            self._copy_file_with_progress(src_wim, dst_dir / src_wim.name)

    def _copy_recursive(self, src: Path, dst: Path):
        if src.is_dir():
            dst.mkdir(parents=True, exist_ok=True)
            for child in src.iterdir():
                self._copy_recursive(child, dst / child.name)
        else:
            self._copy_file_with_progress(src, dst)

    def _copy_file_with_progress(self, src: Path, dst: Path, chunk_size: int = 16 * 1024 * 1024):
        """Copies file in 16MB chunks with live progress updates for large files."""
        total_size = src.stat().st_size

        # For small files (< 50MB), fast stream copy (avoids Darwin fcopyfile/copystat on FAT32)
        if total_size < 50 * 1024 * 1024:
            with open(src, 'rb') as f_in, open(dst, 'wb') as f_out:
                shutil.copyfileobj(f_in, f_out, length=1024 * 1024)
            return

        copied = 0
        last_print = 0
        start_time = time.time()

        with open(src, 'rb') as f_in, open(dst, 'wb') as f_out:
            while True:
                chunk = f_in.read(chunk_size)
                if not chunk:
                    break
                f_out.write(chunk)
                copied += len(chunk)

                now = time.time()
                if now - last_print > 0.5 or copied == total_size:
                    last_print = now
                    pct = (copied / total_size) * 100
                    speed = (copied / (now - start_time + 0.001)) / (1024 * 1024)
                    bar_len = 30
                    filled = int(bar_len * (copied / total_size))
                    bar = "█" * filled + "░" * (bar_len - filled)
                    sys.stdout.write(f"\r  {Colors.CYAN}{src.name}{Colors.RESET} [{bar}] {pct:5.1f}% ({speed:.1f} MB/s) ")
                    sys.stdout.flush()

        sys.stdout.write("\n")
        sys.stdout.flush()


